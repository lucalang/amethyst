# Copy to .env.local for the Next.js app. Never commit real values.
# Local values are printed by `npx supabase status`.

# --- Public (safe to expose to the browser) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public base URL of this app (used for redirects and email links).
APP_URL=http://localhost:3000

# --- Uploaded images: private Cloudflare R2 bucket (server-only) ---------------
# All four or none. Never prefix with NEXT_PUBLIC_. Use an R2 API token with
# "Object Read & Write" scoped to this one bucket. Leave unset to keep using
# Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only for jurisdiction buckets, e.g. https://<account id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=
# Where new uploads go: supabase (default, also the rollback) or r2 (cutover).
ATTACHMENT_STORAGE=supabase

# --- Admin scripts and tests only ---------------------------------------------
# Supabase secret key (sb_secret_...). The app itself never uses it; only
# `npm run user:invite` and the integration/E2E tests do. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
