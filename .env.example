# Copy to .env.local for the Next.js app. Never commit real values.
# Local values are printed by `npx supabase status`.

# --- Public (safe to expose to the browser) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public base URL of this app (used for redirects and email links).
APP_URL=http://localhost:3000

# --- Server only ------------------------------------------------------------
# Supabase secret key (sb_secret_...). Used ONLY for server-only OAuth token
# and state storage and admin scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# 32 random bytes, base64 encoded: `openssl rand -base64 32`.
# Encrypts MAL tokens and PKCE verifiers at rest. Must match the worker's value.
TOKEN_ENCRYPTION_KEY=

# Shared secret the app and pg_cron use to invoke the worker Edge Function:
# `openssl rand -hex 32`. Must match supabase/.env (local) or function secrets.
WORKER_SECRET=
# Optional: Edge Function URL poked after enqueueing work for faster pickup.
WORKER_URL=http://127.0.0.1:54321/functions/v1/worker

# --- MyAnimeList (https://myanimelist.net/apiconfig) -------------------------
MAL_CLIENT_ID=
# Required for "web" app types; leave empty for app types without a secret.
MAL_CLIENT_SECRET=
# Must exactly match the App Redirect URL registered with MAL.
MAL_REDIRECT_URI=http://localhost:3000/api/mal/callback

# --- Optional -----------------------------------------------------------------
# Override the Jikan base URL (tests point this at a local fixture server).
# JIKAN_BASE_URL=https://api.jikan.moe/v4
# Extra comma-separated HTTPS hosts allowed for custom cover/banner artwork.
# EXTRA_IMAGE_HOSTS=images.example.com
